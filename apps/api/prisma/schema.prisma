model Sale {
  id                  String   @id @db.Uuid
  branchId            String   @map("branch_id") @db.Uuid
  orderId             String   @map("order_id") @db.Uuid
  status              String
  productGrossMinor   BigInt   @map("product_gross_minor")
  discountMinor       BigInt   @map("discount_minor")
